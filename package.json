{
  "name": "dsh-session-push",
  "version": "0.2.0",
  "description": "长时间会话完成，或会话等待回应超时时，推送到手机：支持 Bark、Server酱 和通用 Webhook，让您放心离开工位。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon.png": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.png",
    "README.md",
    "LICENSE"
  ],
  "icon": "./icon.png",
  "scripts": {
    "test": "node --import ./test/register.mjs test/test.mjs && node test/client-smoke.mjs lib/client.js"
  },
  "engines": {
    "node": ">=22.15"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notify",
    "notification",
    "bark",
    "serverchan",
    "webhook"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haidanQAQ/dsh-session-push.git"
  },
  "bugs": {
    "url": "https://github.com/haidanQAQ/dsh-session-push/issues"
  },
  "homepage": "https://github.com/haidanQAQ/dsh-session-push#readme",
  "license": "MIT"
}
